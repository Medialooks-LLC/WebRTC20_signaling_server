# Optional deployment settings. Copy this file to .env and keep .env private.
# WEBRTC_IMAGE=webrtc20-signaling-server:RELEASE_VERSION
# WEBRTC_BIND_ADDRESS=127.0.0.1
# WEBRTC_HTTP_PORT=8080
# SDK_SIGNALING_URL=https://meet.example.com

# Optional external TURN relay, advertised to browser and native SDK clients.
# A TURN server such as Coturn must be deployed separately.
# Use single quotes so Compose preserves literal dollar signs in credentials.
# Entries: username@password:DNS-or-IPv4-host:port, separated by semicolons.
# Credentials must be printable ASCII without whitespace or : @ ; / \ ? #.
# IPv6, turn:/turns: URI schemes and ?transport=... options are not supported.
# TURN_SERVERS='meeting-user@replace-with-password:turn.example.com:3478'
TURN_SERVERS=

# Optional direct TLS overlay: docker/compose.tls.yaml
# WEBRTC_TLS_PORT=8443
# TLS_CERT_FILE=/absolute/path/fullchain.pem
# TLS_KEY_FILE=/absolute/path/privkey.pem
